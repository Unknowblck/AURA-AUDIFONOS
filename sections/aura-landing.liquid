<script>
(function(){
  var root = document.getElementById('aura-landing');
  if(!root) return;

  /* Navbar scroll state */
  var nav = document.getElementById('aura-nav');
  var onScroll = function(){
    if(window.scrollY > 24){ nav.classList.add('scrolled'); }
    else{ nav.classList.remove('scrolled'); }
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  /* Mobile menu */
  var burger = document.getElementById('aura-burger');
  var menu = document.getElementById('aura-mobileMenu');
  var toggle = function(open){
    burger.classList.toggle('open', open);
    menu.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open ? 'true':'false');
    menu.setAttribute('aria-hidden', open ? 'false':'true');
  };
  burger.addEventListener('click', function(){ toggle(!menu.classList.contains('open')); });
  menu.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){ toggle(false); }); });

  /* Reveal on scroll (with fallback to guarantee visibility) */
  var reveals = root.querySelectorAll('.reveal:not(.in)');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:.05, rootMargin:'0px 0px 0px 0px'});
    reveals.forEach(function(el){ io.observe(el); });
    /* Safety net: if any reveal stays hidden 2.5s after first scroll, force visible */
    var revealFallback = function(){
      setTimeout(function(){
        root.querySelectorAll('.reveal:not(.in)').forEach(function(el){
          var r = el.getBoundingClientRect();
          if(r.top < window.innerHeight + 200){ el.classList.add('in'); }
        });
      }, 2500);
    };
    window.addEventListener('scroll', revealFallback, {passive:true, once:true});
    setTimeout(revealFallback, 3500);
  } else {
    reveals.forEach(function(el){ el.classList.add('in'); });
  }

  /* Hero — scroll-driven frame scrubbing */
  var hero = document.getElementById('aura-inicio');
  var canvas = document.getElementById('aura-heroCanvas');
  var poster = document.getElementById('aura-heroPoster');
  var frameUrls = window.AURA_FRAME_URLS || [];
  if(hero && canvas && frameUrls.length){
    var totalFrames = frameUrls.length;
    var ctx = canvas.getContext('2d');
    var frames = new Array(totalFrames);
    var loaded = 0;
    var currentIdx = 0;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    /* Resize canvas to fill container (with DPR for sharpness) */
    var resize = function(){
      var rect = canvas.getBoundingClientRect();
      if(rect.width === 0 || rect.height === 0) return;
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(currentIdx);
    };

    /* Draw frame N onto canvas using "cover" algorithm */
    var draw = function(idx){
      idx = Math.max(0, Math.min(totalFrames - 1, Math.round(idx)));
      var img = frames[idx];
      if(!img || !img.complete || !img.naturalWidth){
        /* Fall back to nearest loaded frame */
        for(var i = 1; i < totalFrames; i++){
          var a = idx - i, b = idx + i;
          if(a >= 0 && frames[a] && frames[a].complete && frames[a].naturalWidth){ img = frames[a]; break; }
          if(b < totalFrames && frames[b] && frames[b].complete && frames[b].naturalWidth){ img = frames[b]; break; }
        }
        if(!img) return;
      }
      var cw = canvas.width / dpr;
      var ch = canvas.height / dpr;
      var iw = img.naturalWidth;
      var ih = img.naturalHeight;
      var scale = Math.max(cw / iw, ch / ih);
      var w = iw * scale;
      var h = ih * scale;
      var x = (cw - w) / 2;
      var y = (ch - h) / 2;
      ctx.clearRect(0, 0, cw, ch);
      ctx.drawImage(img, x, y, w, h);
      currentIdx = idx;
    };

    /* Lazy load frames: critical first frames immediately, rest in idle time */
    var onFirstReady = function(){
      resize();
      if(poster){ poster.style.transition='opacity .6s ease'; poster.style.opacity='0'; }
    };
    var loadFrame = function(i){
      if(frames[i]) return;
      var img = new Image();
      img.decoding = 'async';
      img.onload = function(){ loaded++; if(i === 0){ onFirstReady(); } };
      img.onerror = function(){ loaded++; };
      img.src = frameUrls[i];
      frames[i] = img;
    };
    /* Load first 8 frames immediately (covers initial paint + first scroll) */
    var initialBatch = Math.min(8, totalFrames);
    for(var k = 0; k < initialBatch; k++){ loadFrame(k); }
    /* Load rest in idle time so it doesn't compete with critical work */
    var loadRestIdle = function(){
      var idx = initialBatch;
      var loadNext = function(){
        if(idx >= totalFrames) return;
        loadFrame(idx++);
        if('requestIdleCallback' in window){
          requestIdleCallback(loadNext, {timeout:200});
        } else {
          setTimeout(loadNext, 30);
        }
      };
      if('requestIdleCallback' in window){
        requestIdleCallback(loadNext, {timeout:500});
      } else {
        setTimeout(loadNext, 300);
      }
    };
    if(document.readyState === 'complete'){ loadRestIdle(); }
    else { window.addEventListener('load', loadRestIdle, {once:true}); }

    /* Scroll handler — map scroll progress through hero to frame index */
    var ticking = false;
    var onScroll = function(){
      if(ticking) return;
      ticking = true;
      requestAnimationFrame(function(){
        var rect = hero.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var scrolled = -rect.top;
        var maxScroll = rect.height - vh;
        var progress = maxScroll > 0 ? scrolled / maxScroll : 0;
        if(progress < 0) progress = 0;
        if(progress > 1) progress = 1;
        var frame = progress * (totalFrames - 1);
        draw(frame);
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', resize);
    /* Initial draw once first frame loads */
    setTimeout(onScroll, 100);
  }

  /* Instant checkout — intercept Comprar clicks, POST to /cart/add, redirect to /checkout */
  var buyBtns = root.querySelectorAll('[data-aura-buy]');
  buyBtns.forEach(function(btn){
    btn.addEventListener('click', function(e){
      var vid = btn.getAttribute('data-variant-id');
      if(!vid) return; /* No variant -> let href take over (fallback) */
      e.preventDefault();
      btn.style.pointerEvents = 'none';
      var original = btn.innerHTML;
      btn.innerHTML = 'Cargando…';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({id: parseInt(vid,10), quantity: 1})
      }).then(function(r){
        if(!r.ok) throw new Error('add failed');
        window.location.href = '/checkout';
      }).catch(function(){
        /* Fallback: use href (cart permalink) which still works */
        window.location.href = btn.getAttribute('href');
      });
    });
  });

  /* Defer func video load until visible (saves 1.7MB on initial mobile load) */
  var funcVideo = document.getElementById('aura-funcVideo');
  if(funcVideo && 'IntersectionObserver' in window){
    var vio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          funcVideo.preload = 'auto';
          funcVideo.load();
          var p = funcVideo.play(); if(p && p.catch){ p.catch(function(){}); }
          vio.unobserve(funcVideo);
        }
      });
    }, {rootMargin:'200px 0px'});
    vio.observe(funcVideo);
  }
})();
</script>

