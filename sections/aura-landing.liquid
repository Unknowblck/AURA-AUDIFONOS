<script>
(function(){
  var root = document.getElementById('aura-landing');
  if(!root) return;

  /* Navbar scroll state */
  var nav = document.getElementById('aura-nav');
  var onScroll = function(){
    if(window.scrollY > 24){ nav.classList.add('scrolled'); }
    else{ nav.classList.remove('scrolled'); }
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  /* Mobile menu */
  var burger = document.getElementById('aura-burger');
  var menu = document.getElementById('aura-mobileMenu');
  var toggle = function(open){
    burger.classList.toggle('open', open);
    menu.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open ? 'true':'false');
    menu.setAttribute('aria-hidden', open ? 'false':'true');
  };
  burger.addEventListener('click', function(){ toggle(!menu.classList.contains('open')); });
  menu.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){ toggle(false); }); });

  /* Reveal on scroll (with fallback to guarantee visibility) */
  var reveals = root.querySelectorAll('.reveal:not(.in)');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:.05, rootMargin:'0px 0px 0px 0px'});
    reveals.forEach(function(el){ io.observe(el); });
    /* Safety net: if any reveal stays hidden 2.5s after first scroll, force visible */
    var revealFallback = function(){
      setTimeout(function(){
        root.querySelectorAll('.reveal:not(.in)').forEach(function(el){
          var r = el.getBoundingClientRect();
          if(r.top < window.innerHeight + 200){ el.classList.add('in'); }
        });
      }, 2500);
    };
    window.addEventListener('scroll', revealFallback, {passive:true, once:true});
    setTimeout(revealFallback, 3500);
  } else {
    reveals.forEach(function(el){ el.classList.add('in'); });
  }

  /* Hero — scroll-driven frame scrubbing */
  var hero = document.getElementById('aura-inicio');
  var canvas = document.getElementById('aura-heroCanvas');
  var poster = document.getElementById('aura-heroPoster');
  var frameUrls = window.AURA_FRAME_URLS || [];
  if(hero && canvas && frameUrls.length){
    var totalFrames = frameUrls.length;
    var ctx = canvas.getContext('2d');
    var frames = new Array(totalFrames);
    var loaded = 0;
    var currentIdx = 0;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    /* Resize canvas to fill container (with DPR for sharpness) */
    var resize = function(){
      var rect = canvas.getBoundingClientRect();
      if(rect.width === 0 || rect.height === 0) return;
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(currentIdx);
    };

    /* Draw frame N onto canvas using "cover" algorithm */
    var draw = function(idx){
      idx = Math.max(0, Math.min(totalFrames - 1, Math.round(idx)));
      var img = frames[idx];
      if(!img || !img.complete || !img.naturalWidth){
        /* Fall back to nearest loaded frame */
        for(var i = 1; i < totalFrames; i++){
          var a = idx - i, b = idx + i;
          if(a >= 0 && frames[a] && frames[a].complete && frames[a].naturalWidth){ img = frames[a]; break; }
          if(b < totalFrames && frames[b] && frames[b].complete && frames[b].naturalWidth){ img = frames[b]; break; }
        }
        if(!img) return;
      }
      var cw = canvas.width / dpr;
      var ch = canvas.height / dpr;
      var iw = img.naturalWidth;
      var ih = img.naturalHeight;
      var scale = Math.max(cw / iw, ch / ih);
      var w = iw * scale;
      var h = ih * scale;
      var x = (cw - w) / 2;
      var y = (ch - h) / 2;
      ctx.clearRect(0, 0, cw, ch);
      ctx.drawImage(img, x, y, w, h);
      currentIdx = idx;
    };

    /* Lazy load frames: critical first frames immediately, rest in idle time */
    var onFirstReady = function(){
      resize();
      if(poster){ poster.style.transition='opacity .6s ease'; poster.style.opacity='0'; }
    };
    var loadFrame = function(i){
      if(frames[i]) return;
      var img = new Image();
      img.decoding = 'async';
      img.onload = function(){ loaded++; if(i === 0){ onFirstReady(); } };
      img.onerror = function(){ loaded++; };
      img.src = frameUrls[i];
      frames[i] = img;
    };
    /* Load first 8 frames immediately (covers initial paint + first scroll) */
    var initialBatch = Math.min(8, totalFrames);
    for(var k = 0; k < initialBatch; k++){ loadFrame(k); }
    /* Load rest in idle time so it doesn't compete with critical work */
    var loadRestIdle = function(){
      var idx = initialBatch;
      var loadNext = function(){
        if(idx >= totalFrames) return;
        loadFrame(idx++);
        if('requestIdleCallback' in window){
          requestIdleCallback(loadNext, {timeout:200});
        } else {
          setTimeout(loadNext, 30);
        }
      };
      if('requestIdleCallback' in window){
        requestIdleCallback(loadNext, {timeout:500});
      } else {
        setTimeout(loadNext, 300);
      }
    };
    if(document.readyState === 'complete'){ loadRestIdle(); }
    else { window.addEventListener('load', loadRestIdle, {once:true}); }

    /* Hero text stages — set up + activate based on scroll progress */
    var stages = root.querySelectorAll('#aura-heroStages .hero-stage');
    var lastStageIdx = -1;
    var setStage = function(idx){
      if(idx === lastStageIdx) return;
      lastStageIdx = idx;
      stages.forEach(function(s, i){ s.classList.toggle('active', i === idx); });
    };

    /* Scroll handler — map scroll progress through hero to frame index + stage */
    var ticking = false;
    var onScroll = function(){
      if(ticking) return;
      ticking = true;
      requestAnimationFrame(function(){
        var rect = hero.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var scrolled = -rect.top;
        var maxScroll = rect.height - vh;
        var progress = maxScroll > 0 ? scrolled / maxScroll : 0;
        if(progress < 0) progress = 0;
        if(progress > 1) progress = 1;
        var frame = progress * (totalFrames - 1);
        draw(frame);
        /* 4 stages mapped to 4 progress ranges (0-.25, .25-.5, .5-.75, .75-1) */
        var stageIdx;
        if(progress < 0.28) stageIdx = 0;
        else if(progress < 0.56) stageIdx = 1;
        else if(progress < 0.78) stageIdx = 2;
        else stageIdx = 3;
        setStage(stageIdx);
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', resize);
    /* Initial draw once first frame loads */
    setTimeout(onScroll, 100);
  }

  /* Barra sticky de compra (movil): aparece tras el hero y se oculta sobre la seccion de precio
     para no duplicar el CTA. Todos los botones agregan al carrito y van directo al checkout de Shopify. */
  var sticky = document.getElementById('aura-stickyBuy');
  if(sticky){
    var nearBuy = false;
    var priceZone = root.querySelector('#aura-precio');
    var updateSticky = function(){
      var past = window.scrollY > (window.innerHeight * 0.7);
      if(past && !nearBuy){ sticky.classList.add('show'); }
      else{ sticky.classList.remove('show'); }
    };
    if('IntersectionObserver' in window && priceZone){
      var sbio = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ nearBuy = e.isIntersecting; updateSticky(); });
      }, {rootMargin:'0px 0px -35% 0px'});
      sbio.observe(priceZone);
    }
    window.addEventListener('scroll', updateSticky, {passive:true});
    updateSticky();
  }

  /* Carrito desplegable: se abre al agregar, muestra que hay en el carrito y lleva a /checkout. */
  var cartOverlay = document.getElementById('auraCartOverlay');
  var cartDrawer = document.getElementById('auraCartDrawer');
  var cartBody = document.getElementById('auraCartBody');
  var cartTotal = document.getElementById('auraCartTotal');
  var cartClose = document.getElementById('auraCartClose');

  var formatMoney = function(cents){
    return '$' + Math.round(cents / 100).toLocaleString('es-CO');
  };

  var closeAuraCart = function(){
    if(!cartDrawer) return;
    cartDrawer.classList.remove('open');
    if(cartOverlay) cartOverlay.classList.remove('open');
    cartDrawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  var renderAuraCart = function(cart){
    if(!cartBody) return;
    if(!cart.items || !cart.items.length){
      cartBody.innerHTML = '<p class="cart-drawer__empty">Tu carrito está vacío.</p>';
    } else {
      cartBody.innerHTML = cart.items.map(function(item){
        var img = item.image ? item.image.replace(/\.(jpg|jpeg|png|gif|webp)(\?.*)?$/i, '_200x.$1$2') : '';
        return '<div class="cart-drawer__item">' +
          (img ? '<img src="' + img + '" alt="" loading="lazy">' : '') +
          '<div class="cart-drawer__item-info">' +
            '<div class="cart-drawer__item-title">' + item.product_title + '</div>' +
            '<div class="cart-drawer__item-qty">Cantidad: ' + item.quantity + '</div>' +
          '</div>' +
          '<div class="cart-drawer__item-price">' + formatMoney(item.final_line_price) + '</div>' +
        '</div>';
      }).join('');
    }
    if(cartTotal) cartTotal.textContent = formatMoney(cart.total_price);
  };

  var openAuraCart = function(){
    if(!cartDrawer) return Promise.resolve();
    cartDrawer.classList.add('open');
    if(cartOverlay) cartOverlay.classList.add('open');
    cartDrawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    return fetch('/cart.js', {headers:{'Accept':'application/json'}})
      .then(function(r){ return r.json(); })
      .then(renderAuraCart)
      .catch(function(){
        if(cartBody){ cartBody.innerHTML = '<p class="cart-drawer__empty">No se pudo cargar el carrito.</p>'; }
      });
  };

  if(cartOverlay){ cartOverlay.addEventListener('click', closeAuraCart); }
  if(cartClose){ cartClose.addEventListener('click', closeAuraCart); }
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeAuraCart(); });

  /* Flujo de compra: agrega al carrito por AJAX y abre el carrito desplegable.
     El fallback de <form action="/cart/add?return_to=/checkout"> cubre navegadores sin JS. */
  var buyForms = root.querySelectorAll('[data-aura-buy]');
  buyForms.forEach(function(form){
    form.addEventListener('submit', function(e){
      var idInput = form.querySelector('input[name="id"]');
      if(!idInput || !idInput.value) return;
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var originalText = btn ? btn.innerHTML : '';
      if(btn){
        btn.disabled = true;
        btn.style.pointerEvents = 'none';
        btn.innerHTML = 'Agregando…';
      }
      var fd = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        body: fd,
        headers: {'Accept':'application/json'}
      }).then(function(r){
        if(!r.ok) throw new Error('add failed');
        return openAuraCart();
      }).then(function(){
        if(btn){
          btn.disabled = false;
          btn.style.pointerEvents = '';
          btn.innerHTML = originalText;
        }
      }).catch(function(){
        form.submit();
      });
    });
  });

  /* Defer func video load until visible (saves 1.7MB on initial mobile load) */
  var funcVideo = document.getElementById('aura-funcVideo');
  if(funcVideo && 'IntersectionObserver' in window){
    var vio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          funcVideo.preload = 'auto';
          funcVideo.load();
          var p = funcVideo.play(); if(p && p.catch){ p.catch(function(){}); }
          vio.unobserve(funcVideo);
        }
      });
    }, {rootMargin:'200px 0px'});
    vio.observe(funcVideo);
  }
})();
</script>

