  /* Resaltado de ENVIO GRATIS en la tarjeta de precio */
  .aura-landing .price-card .free-ship{display:inline-flex;align-items:center;gap:9px;margin:14px auto 0;padding:9px 18px;border-radius:100px;background:rgba(255,90,31,.16);border:1px solid rgba(255,90,31,.5);color:#fff;font-weight:700;font-size:.9rem;letter-spacing:.03em;text-transform:uppercase;position:relative;}
  .aura-landing .price-card .free-ship svg{width:18px;height:18px;color:var(--aura-accent);flex:none;}

  /* Carrito desplegable (se abre al agregar al carrito) */
  .aura-landing .cart-overlay{
    position:fixed;inset:0;z-index:90;background:rgba(8,8,8,.5);
