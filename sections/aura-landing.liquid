  .aura-landing .faq-item[open] summary::after{transform:rotate(45deg);}
  .aura-landing .faq-item .faq-a{padding:0 24px 20px;color:var(--aura-muted);font-weight:300;line-height:1.6;font-size:.96rem;}
  .aura-landing .faq-item .faq-a strong{color:var(--aura-ink);font-weight:600;}

  /* Que la barra sticky no tape el footer en movil */
  @media(max-width:879px){.aura-landing .aura-foot{padding-bottom:96px;}}

  /* Slot del boton de compra en la tarjeta de precio + scroll suave a el */
  .aura-landing .aura-cod-slot{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;}
