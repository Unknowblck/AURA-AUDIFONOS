  }
  .aura-landing .cart-drawer__head h3{font-size:1.3rem;}
  .aura-landing .cart-drawer__head h3 .o{color:var(--aura-accent);}
  .aura-landing .cart-drawer__close{background:none;border:0;cursor:pointer;color:var(--aura-ink);padding:6px;line-height:1;}
  .aura-landing .cart-drawer__close svg{width:22px;height:22px;}
  .aura-landing .cart-drawer__body{flex:1;overflow-y:auto;padding:20px 22px;}
  .aura-landing .cart-drawer__item{display:flex;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--aura-line);}
  .aura-landing .cart-drawer__item img{width:72px;height:72px;border-radius:14px;object-fit:cover;background:var(--aura-cloud);flex:none;}
  .aura-landing .cart-drawer__item-info{flex:1;min-width:0;}
