{% comment %}
  AURA Landing — single-shot Shopify section.
  Replica el landing del prototipo HTML/CSS/JS. Editable desde el theme editor:
  precio, stock y URL del botón Comprar.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{%- comment -%} Producto AURA: lo detectamos para (1) leer el precio REAL de Shopify y (2) enviar cada boton a su pagina, donde vive el formulario de pago contra entrega (Releasit). {%- endcomment -%}
{%- assign aura_product = all_products['audifonos'] -%}

{%- comment -%} Destino de los botones: la pagina del producto. Se puede sobreescribir con el setting checkout_url. {%- endcomment -%}
{%- assign product_url = aura_product.url | default: '/products/audifonos' -%}
{%- if section.settings.checkout_url != blank -%}
  {%- assign product_url = section.settings.checkout_url -%}
{%- endif -%}

{%- comment -%} Precio: preferimos el precio real del producto para que el landing nunca quede desincronizado del checkout. Si el producto no existe, usamos los valores manuales. {%- endcomment -%}
{%- if aura_product and aura_product.price > 0 -%}
  {%- assign price_now = aura_product.price | money -%}
  {%- if aura_product.compare_at_price > aura_product.price -%}
    {%- assign price_was = aura_product.compare_at_price | money -%}
    {%- assign aura_save_amt = aura_product.compare_at_price | minus: aura_product.price | money -%}
    {%- assign price_save = 'Ahorras ' | append: aura_save_amt -%}
  {%- else -%}
    {%- assign price_was = section.settings.price_was -%}
    {%- assign price_save = section.settings.price_save -%}
  {%- endif -%}
{%- else -%}
  {%- assign price_now = section.settings.price_now | default: '$119.900' -%}
  {%- assign price_was = section.settings.price_was | default: '$345.900' -%}
  {%- assign price_save = section.settings.price_save | default: 'Ahorras $226.000' -%}
{%- endif -%}
{%- assign stock_left = section.settings.stock_left | default: '17' -%}
{%- assign shipping_time = section.settings.shipping_time | default: '2 a 5 dias habiles' -%}
{%- assign wa_number = section.settings.whatsapp_number | default: '' -%}
{%- assign wa_message = section.settings.whatsapp_message | default: 'Hola, quiero pedir los audifonos AURA con pago contra entrega' -%}

{%- comment -%} Preload first frame and hero poster for fast LCP {%- endcomment -%}
<link rel="preload" as="image" href="{{ 'aura-hero-poster.webp' | asset_url }}" fetchpriority="high">
<link rel="preload" as="image" href="{{ 'aura-frame-001.webp' | asset_url }}">

<style>
  .aura-landing{
    --aura-bg:#F5F3EE;
    --aura-ink:#080808;
    --aura-accent:#FF5A1F;
    --aura-muted:#8A857C;
    --aura-cloud:#FAF8F3;
    --aura-line:rgba(8,8,8,.10);
    --aura-maxw:1200px;
    --aura-ease:cubic-bezier(.22,.61,.36,1);
    background:var(--aura-bg);
    color:var(--aura-ink);
    font-family:'Inter',system-ui,sans-serif;
    font-weight:400;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
    overflow-x:clip;
  }
  .aura-landing *{box-sizing:border-box;}
  .aura-landing img,.aura-landing video{display:block;max-width:100%;}
  .aura-landing a{color:inherit;text-decoration:none;}
  .aura-landing ::selection{background:var(--aura-accent);color:#fff;}
  .aura-landing :focus-visible{outline:2px solid var(--aura-accent);outline-offset:3px;border-radius:2px;}

  .aura-landing h1,
  .aura-landing h2,
  .aura-landing h3{
    font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;
    letter-spacing:.005em;line-height:.92;margin:0;
  }
  .aura-landing .eyebrow{
    font-size:.72rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;
    color:var(--aura-accent);display:inline-flex;align-items:center;gap:.6em;
  }
  .aura-landing .wrap{max-width:var(--aura-maxw);margin:0 auto;padding:0 22px;}
  .aura-landing section{position:relative;}
  .aura-landing .lead{font-size:clamp(1.05rem,1rem + .6vw,1.3rem);color:#2a2722;font-weight:300;line-height:1.6;}

  /* Reveal */
  .aura-landing .reveal{opacity:0;transform:translateY(26px);transition:opacity .9s var(--aura-ease),transform .9s var(--aura-ease);}
  .aura-landing .reveal.in{opacity:1;transform:none;}
  .aura-landing .reveal[data-d="1"]{transition-delay:.08s;}
  .aura-landing .reveal[data-d="2"]{transition-delay:.16s;}
  .aura-landing .reveal[data-d="3"]{transition-delay:.24s;}
  .aura-landing .reveal[data-d="4"]{transition-delay:.32s;}
  @media (prefers-reduced-motion:reduce){
    .aura-landing .reveal{opacity:1 !important;transform:none !important;transition:none;}
  }

  /* Formularios de compra: se comportan como su boton hijo, sin romper flex/inline layouts */
  .aura-landing .aura-buy-form{display:contents;margin:0;padding:0;}
  .aura-landing .aura-buy-form button.btn{font:inherit;}

  /* Buttons */
  .aura-landing .btn{
    --pad:15px 26px;
    display:inline-flex;align-items:center;gap:.55em;
    padding:var(--pad);border-radius:100px;font-weight:600;font-size:.95rem;letter-spacing:.01em;
    cursor:pointer;border:1px solid transparent;
    transition:transform .35s var(--aura-ease),background .35s var(--aura-ease),color .35s var(--aura-ease),box-shadow .35s var(--aura-ease);
    white-space:nowrap;text-decoration:none;
  }
  .aura-landing .btn .arr{transition:transform .35s var(--aura-ease);}
  .aura-landing .btn:hover .arr{transform:translateX(4px);}
  .aura-landing .btn-primary{background:var(--aura-accent);color:#fff;box-shadow:0 12px 30px -12px rgba(255,90,31,.7);}
  .aura-landing .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 40px -14px rgba(255,90,31,.8);}
  .aura-landing .btn-ghost{background:transparent;color:var(--aura-ink);border-color:var(--aura-line);}
  .aura-landing .btn-ghost:hover{background:var(--aura-ink);color:var(--aura-bg);border-color:var(--aura-ink);}
  .aura-landing .btn-light{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.35);backdrop-filter:blur(6px);}
  .aura-landing .btn-light:hover{background:#fff;color:var(--aura-ink);transform:translateY(-2px);}

  /* Navbar — solid background, no border, no blur, no shadow */
  .aura-landing .nav,
  .aura-landing .nav.scrolled{
    position:sticky;top:0;z-index:60;
    background:var(--aura-bg) !important;
    border:0 !important;
    box-shadow:none !important;
    filter:none !important;
    backdrop-filter:none !important;
    -webkit-backdrop-filter:none !important;
    outline:0 !important;
  }
  .aura-landing .nav-in,
  .aura-landing .nav *{
    border:0 !important;
    box-shadow:none !important;
  }
  /* Re-allow button shadow specifically */
  .aura-landing .nav .btn-primary{
    box-shadow:0 12px 30px -12px rgba(255,90,31,.7) !important;
  }
  .aura-landing .nav-in{display:flex;align-items:center;justify-content:space-between;height:68px;}
  .aura-landing .logo{font-family:'Anton',sans-serif;font-size:1.45rem;letter-spacing:.16em;text-transform:uppercase;color:var(--aura-ink);}
  .aura-landing .logo .dot{color:var(--aura-accent);}
  .aura-landing .nav-links{display:none;gap:34px;align-items:center;list-style:none;padding:0;margin:0;}
  .aura-landing .nav-links a{font-size:.92rem;color:#2a2722;position:relative;padding:4px 0;font-weight:500;}
  .aura-landing .nav-links a::after{content:"";position:absolute;left:0;bottom:-2px;height:1.5px;width:0;background:var(--aura-accent);transition:width .3s var(--aura-ease);}
  .aura-landing .nav-links a:hover::after{width:100%;}
  .aura-landing .nav-right{display:flex;align-items:center;gap:14px;}
  .aura-landing .nav-cta{display:none;}
  .aura-landing .nav-cod{display:none;font-size:.76rem;font-weight:500;color:var(--aura-muted);white-space:nowrap;}
  .aura-landing .burger{display:inline-flex;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:8px;}
  .aura-landing .burger span{width:22px;height:2px;background:var(--aura-ink);transition:.3s var(--aura-ease);}
  .aura-landing .burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .aura-landing .burger.open span:nth-child(2){opacity:0;}
  .aura-landing .burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
  .aura-landing .mobile-menu{
    position:fixed;inset:68px 0 auto 0;z-index:55;background:var(--aura-bg);
    border-bottom:1px solid var(--aura-line);
    transform:translateY(-110%);transition:transform .45s var(--aura-ease);
    padding:14px 22px 26px;
  }
  .aura-landing .mobile-menu.open{transform:translateY(0);}
  .aura-landing .mobile-menu a{display:block;font-size:1.5rem;font-family:'Anton',sans-serif;text-transform:uppercase;padding:12px 0;border-bottom:1px solid var(--aura-line);color:var(--aura-ink);}
  .aura-landing .mobile-menu .btn{margin-top:18px;width:100%;justify-content:center;}
  @media(min-width:880px){
    .aura-landing .nav-links{display:flex;}
    .aura-landing .nav-cta{display:inline-flex;}
    .aura-landing .nav-cod{display:inline-flex;}
    .aura-landing .burger{display:none;}
  }

  /* Hero — scroll-driven frame scrubbing */
  .aura-landing .hero{
    min-height:180vh;position:relative;overflow:visible;
    background:#e9e4da;
  }
  .aura-landing .hero-sticky{
    position:sticky;top:0;height:100vh;width:100%;
    display:flex;align-items:flex-end;overflow:hidden;
    background:#e9e4da url('{{ 'aura-hero-poster.webp' | asset_url }}') center/cover no-repeat;
  }
  .aura-landing .hero-canvas,
  .aura-landing .hero-poster{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;
    display:block;
  }
  .aura-landing .hero-sticky::after{
    content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background:
      linear-gradient(to top,rgba(15,12,8,.62) 0%,rgba(15,12,8,.12) 38%,rgba(15,12,8,0) 60%),
      linear-gradient(to right,rgba(15,12,8,.34) 0%,rgba(15,12,8,0) 55%);
  }
  .aura-landing .hero-in{position:relative;z-index:2;width:100%;padding-bottom:clamp(40px,7vh,80px);padding-top:clamp(72px,9vh,108px);}
  @media (max-width:760px){
    .aura-landing .hero{min-height:135vh;}
    .aura-landing .hero-in{padding-top:78px;}
  }

  /* Hero text stages — cross-fade with scroll */
  .aura-landing .hero-stages{
    display:grid;grid-template-columns:1fr;position:relative;
  }
  .aura-landing .hero-stage{
    grid-area:1/1/2/2;
    opacity:0;transform:translateY(28px);
    transition:opacity .55s var(--aura-ease),transform .55s var(--aura-ease);
    pointer-events:none;
    will-change:opacity,transform;
  }
  .aura-landing .hero-stage.active{
    opacity:1;transform:translateY(0);pointer-events:auto;
  }
  .aura-landing .hero-stage h1{
    color:#fff;font-size:clamp(2.4rem,6.6vw,5.4rem);max-width:16ch;
    text-shadow:0 2px 40px rgba(0,0,0,.25);
  }
  .aura-landing .hero-stage h1 .o{color:var(--aura-accent);}
  .aura-landing .hero-stage .eyebrow{margin-bottom:14px;}
  .aura-landing .hero-stage .hero-sub{
    color:rgba(255,255,255,.9);font-weight:300;
    font-size:clamp(1rem,1rem + .5vw,1.2rem);max-width:46ch;
    margin:22px 0 0;
  }
  /* Final stage carries the price + CTAs */
  .aura-landing .hero-stage.stage-final .hero-price{margin:20px 0 6px;}
  .aura-landing .hero-stage.stage-final .hero-urgency{margin:14px 0 22px;}
  .aura-landing .hero-stage.stage-final .hero-actions{margin-top:0;}
  .aura-landing .hero-stage.stage-final .social-proof{margin-top:24px;}
  .aura-landing .hero-stage.stage-final h1{font-size:clamp(2.6rem,7vw,5.8rem);}
  .aura-landing .hero h1{
    color:#fff;font-size:clamp(2.9rem,8.4vw,6.6rem);max-width:14ch;
    text-shadow:0 2px 40px rgba(0,0,0,.25);
  }
  .aura-landing .hero h1 .o{color:var(--aura-accent);}
  .aura-landing .hero-sub{color:rgba(255,255,255,.9);font-weight:300;font-size:clamp(1rem,1rem + .5vw,1.25rem);max-width:46ch;margin:22px 0 30px;}
  .aura-landing .hero-price{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin:4px 0 16px;}
  .aura-landing .hero-price .hp-now{font-family:'Anton',sans-serif;color:#fff;font-size:clamp(2rem,1.6rem + 3vw,3.2rem);line-height:.9;text-shadow:0 2px 30px rgba(0,0,0,.3);}
  .aura-landing .hero-price .hp-was{color:rgba(255,255,255,.72);text-decoration:line-through;font-size:1rem;font-weight:300;text-transform:uppercase;letter-spacing:.04em;}
  .aura-landing .hero-actions{display:flex;flex-wrap:wrap;gap:14px;align-items:center;}
  .aura-landing .hero-urgency{
    display:inline-flex;align-items:center;gap:10px;margin:0 0 26px;padding:9px 16px;border-radius:100px;
    background:rgba(255,90,31,.14);border:1px solid rgba(255,90,31,.45);backdrop-filter:blur(6px);
    color:#fff;font-size:.86rem;font-weight:500;letter-spacing:.01em;
  }
  .aura-landing .hero-urgency strong{font-weight:700;color:var(--aura-accent);}
  .aura-landing .hero-urgency .pulse{width:9px;height:9px;border-radius:50%;background:var(--aura-accent);flex:none;position:relative;}
  .aura-landing .hero-urgency .pulse::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1px solid var(--aura-accent);animation:aura-pulse 1.8s var(--aura-ease) infinite;}
  @keyframes aura-pulse{0%{transform:scale(.6);opacity:.9}100%{transform:scale(1.9);opacity:0}}
  @media (prefers-reduced-motion:reduce){.aura-landing .hero-urgency .pulse::after{animation:none;}}
  .aura-landing .social-proof{display:flex;align-items:center;gap:14px;margin-top:30px;color:#fff;flex-wrap:wrap;}
  .aura-landing .stars{color:var(--aura-accent);letter-spacing:2px;font-size:1rem;}
  .aura-landing .social-proof .sp-text{font-size:.9rem;color:rgba(255,255,255,.88);}
  .aura-landing .social-proof .sp-text strong{font-weight:600;color:#fff;}
  .aura-landing .scroll-cue{
    position:absolute;left:50%;bottom:18px;transform:translateX(-50%);z-index:3;
    color:rgba(255,255,255,.8);font-size:.68rem;letter-spacing:.25em;text-transform:uppercase;
    display:flex;flex-direction:column;align-items:center;gap:8px;
  }
  .aura-landing .scroll-cue .bar{width:1px;height:34px;background:linear-gradient(to bottom,rgba(255,255,255,.7),transparent);animation:aura-cue 2.2s var(--aura-ease) infinite;}
  @keyframes aura-cue{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
  @media (max-width:760px),(max-height:740px){.aura-landing .scroll-cue{display:none;}}

  .aura-landing .pad{padding:clamp(74px,11vh,140px) 0;}
  .aura-landing .section-head{max-width:62ch;}
  .aura-landing .section-head h2{font-size:clamp(2.1rem,2rem + 3.4vw,4.4rem);margin-top:18px;}

  /* Problema */
  .aura-landing .problema{background:var(--aura-ink);color:var(--aura-cloud);overflow:hidden;}
  .aura-landing .problema .eyebrow{color:var(--aura-accent);}
  .aura-landing .problema .big{
    font-family:'Anton',sans-serif;text-transform:uppercase;
    font-size:clamp(1.8rem,1.5rem + 3.6vw,4rem);line-height:1.02;letter-spacing:.005em;
    max-width:18ch;
  }
  .aura-landing .problema .big em{font-style:normal;color:var(--aura-accent);}
  .aura-landing .problema .pq{display:grid;gap:40px;align-items:end;grid-template-columns:1fr;margin-top:46px;}
  .aura-landing .problema p{color:rgba(250,248,243,.72);font-weight:300;max-width:42ch;}
  .aura-landing .problema .stat{font-family:'Anton',sans-serif;font-size:clamp(3rem,2rem + 6vw,6rem);color:#fff;line-height:.9;}
  .aura-landing .problema .stat span{display:block;font-family:'Inter';font-size:.85rem;font-weight:400;color:var(--aura-muted);text-transform:none;letter-spacing:.02em;margin-top:12px;max-width:24ch;}
  @media(min-width:820px){.aura-landing .problema .pq{grid-template-columns:1.4fr .9fr;gap:60px;}}

  /* Solución */
  .aura-landing .sol-grid{display:grid;gap:14px;grid-template-columns:1fr;margin-top:56px;}
  .aura-landing .sol-card{
    background:var(--aura-cloud);border:1px solid var(--aura-line);border-radius:20px;padding:34px 30px;
    transition:transform .5s var(--aura-ease),box-shadow .5s var(--aura-ease);
  }
  .aura-landing .sol-card:hover{transform:translateY(-5px);box-shadow:0 26px 50px -30px rgba(8,8,8,.3);}
  .aura-landing .sol-num{font-family:'Anton',sans-serif;color:var(--aura-accent);font-size:.9rem;letter-spacing:.1em;}
  .aura-landing .ico{width:52px;height:52px;border-radius:14px;background:#fff;border:1px solid var(--aura-line);display:grid;place-items:center;margin:18px 0 22px;color:var(--aura-accent);}
  .aura-landing .ico svg{width:26px;height:26px;}
  .aura-landing .sol-card h3{font-size:1.5rem;text-transform:none;font-family:'Inter';font-weight:600;letter-spacing:-.01em;line-height:1.15;}
  .aura-landing .sol-card p{color:var(--aura-muted);font-size:.96rem;margin:12px 0 0;font-weight:300;}
  @media(min-width:760px){.aura-landing .sol-grid{grid-template-columns:repeat(3,1fr);gap:18px;}}

  /* Funciones */
  .aura-landing .func{background:var(--aura-cloud);}
  .aura-landing .func-layout{display:grid;gap:34px;grid-template-columns:1fr;align-items:start;margin-top:54px;}
  .aura-landing .func-visual{position:relative;border-radius:22px;overflow:hidden;background:#e9e4da;aspect-ratio:16/11;border:1px solid var(--aura-line);}
  .aura-landing .func-visual img,
  .aura-landing .func-visual video{width:100%;height:100%;object-fit:cover;display:block;}
  .aura-landing .func-visual .tag{
    position:absolute;left:16px;bottom:16px;background:rgba(8,8,8,.72);color:#fff;backdrop-filter:blur(8px);
    padding:9px 15px;border-radius:100px;font-size:.78rem;letter-spacing:.04em;display:flex;gap:8px;align-items:center;
  }
  .aura-landing .func-visual .tag b{color:var(--aura-accent);font-weight:600;}
  .aura-landing .func-grid{display:grid;gap:0;grid-template-columns:1fr 1fr;border:1px solid var(--aura-line);border-radius:18px;overflow:hidden;background:var(--aura-bg);}
  .aura-landing .func-item{padding:26px 22px;border-right:1px solid var(--aura-line);border-bottom:1px solid var(--aura-line);transition:background .35s var(--aura-ease);}
  .aura-landing .func-item:nth-child(2n){border-right:0;}
  .aura-landing .func-item:nth-last-child(-n+2){border-bottom:0;}
  .aura-landing .func-item:hover{background:var(--aura-cloud);}
  .aura-landing .func-item .fi-ico{color:var(--aura-accent);width:30px;height:30px;margin-bottom:16px;}
  .aura-landing .func-item h3{font-size:1.06rem;text-transform:none;font-family:'Inter';font-weight:600;letter-spacing:-.01em;}
  .aura-landing .func-item p{color:var(--aura-muted);font-size:.86rem;margin:7px 0 0;font-weight:300;line-height:1.5;}
  @media(min-width:920px){
    .aura-landing .func-layout{grid-template-columns:1.02fr .98fr;gap:46px;}
    .aura-landing .func-visual{position:sticky;top:90px;aspect-ratio:4/5;}
  }

  /* Ciencia / Trust */
  .aura-landing .ciencia{background:var(--aura-ink);color:var(--aura-cloud);overflow:hidden;}
  .aura-landing .ciencia .eyebrow{color:var(--aura-accent);}
  .aura-landing .ciencia .section-head h2{color:#fff;}
  .aura-landing .spec-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(250,248,243,.12);border:1px solid rgba(250,248,243,.12);border-radius:20px;overflow:hidden;margin-top:56px;}
  .aura-landing .spec{background:var(--aura-ink);padding:34px 26px;}
  .aura-landing .spec .n{font-family:'Anton',sans-serif;font-size:clamp(2.4rem,2rem + 3.6vw,4.2rem);line-height:.9;color:#fff;}
  .aura-landing .spec .n .u{color:var(--aura-accent);font-size:.42em;vertical-align:top;margin-left:2px;}
  .aura-landing .spec .l{color:var(--aura-muted);font-size:.9rem;margin-top:14px;font-weight:300;line-height:1.5;}
  @media(min-width:820px){.aura-landing .spec-grid{grid-template-columns:repeat(4,1fr);}}
  .aura-landing .badges{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px;}
  .aura-landing .badge{display:flex;align-items:center;gap:9px;border:1px solid rgba(250,248,243,.18);border-radius:100px;padding:11px 18px;font-size:.84rem;color:rgba(250,248,243,.85);}
  .aura-landing .badge svg{width:17px;height:17px;color:var(--aura-accent);flex:none;}

  /* Testimonios */
  .aura-landing .test-grid{display:grid;gap:16px;grid-template-columns:1fr;margin-top:54px;}
  .aura-landing .quote{background:var(--aura-cloud);border:1px solid var(--aura-line);border-radius:20px;padding:34px 30px;display:flex;flex-direction:column;}
