  .aura-landing .cart-drawer__empty{color:var(--aura-muted);text-align:center;padding:40px 0;font-size:.96rem;}
  .aura-landing .cart-drawer__foot{flex:none;padding:20px 22px calc(20px + env(safe-area-inset-bottom));border-top:1px solid var(--aura-line);background:var(--aura-cloud);}
